{
  "permissions": {
    "allow": [
      "Bash(ruff check *)",
      "Bash(mypy *)",
      "Bash(pytest *)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)",
      "Bash(docker compose config *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down)",
      "Bash(docker compose build *)",
      "Bash(pip show *)",
      "Bash(pip list *)",
      "Bash(python:*)",
      "Bash(python3:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(echo \"$CLAUDE_TOOL_INPUT\" | python3 -c \"import sys,json; print(json.load(sys.stdin).get('file_path',''))\" 2>/dev/null); [[ \"$file\" == *.py ]] && ruff check \"$file\" --quiet || exit 0"
          }
        ]
      }
    ]
  }
}