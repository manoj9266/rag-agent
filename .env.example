# Required
GEMINI_API_KEY=
# Local: local Postgres. Production (GCP VM): Neon connection string.
# Get this from Neon dashboard → Connection Details → select "asyncpg" driver.
# Format: postgresql+asyncpg://USER:PASS@ep-xxx.REGION.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ragagent
# Local: local Redis. Production: Upstash TLS URL → rediss://default:PASS@HOST:PORT
REDIS_URL=redis://localhost:6379
JWT_SECRET_KEY=change-me-to-a-long-random-string
ADMIN_KEY=change-me-admin-key

# Optional — defaults shown
JWT_EXPIRE_HOURS=24
VECTOR_BACKEND=faiss
# Production: set to your deployed frontend origin (comma-separated), e.g.
#   ALLOWED_ORIGINS=https://your-app.vercel.app
# Do NOT leave "*" in production (invalid with credentialed requests).
ALLOWED_ORIGINS=*
# Production (GCP VM): point at the mounted volume paths inside the container
# FAISS_INDEX_PATH=/data/faiss_index
# INPUT_DOCS_PATH=/data/input_docs
FAISS_INDEX_PATH=faiss_index
INPUT_DOCS_PATH=input_docs
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
SESSION_TTL_SECONDS=1800
RATE_LIMIT=30/minute
LOG_LEVEL=INFO
LLM_MODEL=gemini-2.5-flash
# Embeddings: "huggingface" (local, free, pulls torch) or "gemini" (API, lean image).
# Production on Railway: use gemini to avoid loading a local model.
EMBEDDING_BACKEND=huggingface
EMBEDDING_MODEL=models/gemini-embedding-001

# Phase 2B — Pinecone (only if VECTOR_BACKEND=pinecone)
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=rag-agent

# Phase 2C — Qdrant (only if VECTOR_BACKEND=qdrant)
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=rag-agent
